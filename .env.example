# intervals.icu API key
# Get this from https://intervals.icu > Settings > Developer Settings
INTERVALS_API_KEY=your_api_key

# Passphrase used to log in to the app
APP_PASSPHRASE=your_passphrase

# Athlete id all Supabase rows are keyed by (the original Strava athlete id)
APP_ATHLETE_ID=your_athlete_id

# Supabase credentials
# Get these from your Supabase project settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
